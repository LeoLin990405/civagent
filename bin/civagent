#!/usr/bin/env bash
set -euo pipefail

# CivAgent v4 — Claude Code Runtime
# Usage: civagent <command> [args]

CIVAGENT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Overridable for tests / sandboxed runs.
REGIMES_DIR="${CIVAGENT_REGIMES_DIR:-$CIVAGENT_ROOT/regimes}"
ENGINE_DIR="$CIVAGENT_ROOT/engine"
STATE_DIR="${HOME}/.civagent"
ACTIVE_FILE="$STATE_DIR/.active-regime"

# Shared helpers (colors, die, validate_regime, metadata reader) — resolved
# relative to this script's own location, not the caller's cwd.
source "$CIVAGENT_ROOT/bin/lib/common.sh"

mkdir -p "$STATE_DIR"

usage() {
  cat <<EOF
${BOLD}CivAgent v5${NC} — 5000 Years of Governance × AI Multi-Agent × Learning Loop

${BOLD}Usage:${NC}
  civagent list                         List all 57 regimes
  civagent info <regime>                Show regime details
  civagent switch <regime>              Set active regime
  civagent run [prompt]                 Launch CC with active regime's agents (v4 mode)
  civagent run --v5 "task"              Launch v5 with isolated HOME + skill sedimentation
  civagent skills <regime> [--stats]    List learned skills (--stats: dedup/quality JSON)
  civagent replay <matchId>             Re-run a past match with the same regime/backend/task
  civagent skills pending [regime]      List staged skills awaiting human approval
  civagent skills approve <regime> <file>
                                        Promote a staged skill into the active skills dir
  civagent match-log                    Recent match transcripts
  civagent tournament --civs a,b,c,d "task"
                                        Parallel match across civilizations + judge ranking
  civagent tournament --civs a,b --task-file tasks/my-scenario.md
                                        Run tournament using a markdown scenario file
  civagent tournament --civs a,b --task-file resources/tasks/t3-todo-cli/task.json [--det-weight 0.5]
                                        T3 mode: deterministic grader blended with judge score
  civagent topology validate <regime>   Validate a regime's topology.json (schema + IDENTITY cross-check)
  civagent topology metrics <regime>    Graph metrics (density, depth, centrality, check cycles) as JSON
  civagent stats [--dir D] [--boot N] [--tie X] [--json] [tournamentDir...]
                                        Cross-tournament Bradley-Terry ranking + bootstrap CI
  civagent ablate <regime> --type persona|checks [--out dir]
                                        Generate an ablation variant into regimes/_ablated/
                                        (A3 skill ablation: run/tournament --no-skill)
  civagent baseline <regime> --type solo|random|flat [--seed N] [--out dir] [--dest dir]
                                        Generate a baseline control variant into regimes/_baseline/
                                        (--dest stages it at an exact runnable path, e.g. regimes/baseline/tang-random)
  civagent hillclimb <analyze|propose|validate|apply|rollback>
                                        L4 loop: diagnose → diff proposals → paired validation → revertible apply
  civagent runtime-graph <matchId> [--diff] [--json]
                                        Reconstruct runtime graph from match events; --diff compares to declared topology
  civagent agents                       Show generated CC agents for active regime
  civagent modes                        List 6 orchestration modes
  civagent setup                        Check tool availability (CC, Codex, opencode, cn-cc)
  civagent doctor                       Verify cn-cc-workflow backends (cn:*) are installed

${BOLD}Examples:${NC}
  civagent switch china/tang
  civagent run --v5 "refactor this module"
  civagent tournament --civs china/tang,china/qin,global/athens,global/roman-republic \\
                     "how do we handle a famine on the eastern frontier?"

${BOLD}Regimes:${NC}
  20 Chinese dynasties: xia, shang, zhou, qin, han, tang, song, ming, qing, ...
  37 Global empires: athens, roman-empire, british, ottoman, us-federal, ...
EOF
}

# ── list ─────────────────────────────────────────────────────────────────────

cmd_list() {
  local active=""
  [[ -f "$ACTIVE_FILE" ]] && active=$(cat "$ACTIVE_FILE")

  echo -e "${BOLD}CivAgent Regimes — 57 Governance Systems${NC}\n"

  echo -e "${CYAN}── Chinese Dynasties (20) ──${NC}"
  for dir in "$REGIMES_DIR"/china/*/; do
    [[ -f "$dir/metadata.json" ]] || continue
    local id=$(basename "$dir")
    local regime="china/$id"
    # One python subprocess per regime (was: four).
    metadata_fields "$dir/metadata.json"
    local name_zh="${META_NAME_ZH:-$id}"
    local era="$META_ERA_ZH"
    local pattern="$META_PATTERN"
    local agents="$META_AGENTS"
    local marker="  "
    [[ "$regime" == "$active" ]] && marker="${GREEN}▸ ${NC}"
    printf "  ${marker}%-22s %-8s %-14s %-24s %s agents\n" "$regime" "$name_zh" "$era" "$pattern" "$agents"
  done

  echo ""
  echo -e "${CYAN}── Global Empires (37) ──${NC}"
  for dir in "$REGIMES_DIR"/global/*/; do
    [[ -f "$dir/metadata.json" ]] || continue
    local id=$(basename "$dir")
    local regime="global/$id"
    # One python subprocess per regime (was: four).
    metadata_fields "$dir/metadata.json"
    local name_en="${META_NAME_EN:-$id}"
    local pattern="$META_PATTERN"
    local agents="$META_AGENTS"
    local marker="  "
    [[ "$regime" == "$active" ]] && marker="${GREEN}▸ ${NC}"
    printf "  ${marker}%-28s %-24s %-24s %s agents\n" "$regime" "$name_en" "$pattern" "$agents"
  done
}

# ── info ─────────────────────────────────────────────────────────────────────

cmd_info() {
  local regime="$1"
  validate_regime "$regime"
  local dir="$REGIMES_DIR/$regime"
  require_regime_metadata "$regime" "$dir"

  python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
print(f\"{'='*60}\")
print(f\"{d['name']['zh']} ({d['name']['en']})\")
print(f\"{d['era']['zh']} | {d['era']['en']}\")
print(f\"System: {d['system']['zh']}\")
print(f\"Pattern: {d.get('orchestrationPattern', '?')}\")
print(f\"Agents: {d.get('agentCount', '?')}\")
print(f\"Tags: {', '.join(d.get('tags', []))}\")
print(f\"{'='*60}\")
print(d['description']['zh'])
print()
print(d['description']['en'])
" "$dir/metadata.json"
}

# ── switch ───────────────────────────────────────────────────────────────────

cmd_switch() {
  local regime="$1"
  validate_regime "$regime"
  local dir="$REGIMES_DIR/$regime"
  require_regime_metadata "$regime" "$dir"

  echo "$regime" > "$ACTIVE_FILE"

  # Generate CLAUDE.md for the regime
  node "$ENGINE_DIR/regime-to-cc.mjs" "$dir" --claude-md > "$STATE_DIR/CLAUDE.md"

  # Generate agents JSON
  node "$ENGINE_DIR/regime-to-cc.mjs" "$dir" --agents > "$STATE_DIR/agents.json"

  # One python subprocess (was: two) — no fallbacks, matching the old output.
  metadata_fields "$dir/metadata.json"
  local name_zh="$META_NAME_ZH"
  local pattern="$META_PATTERN"

  echo -e "${GREEN}✓${NC} Switched to ${BOLD}$name_zh${NC} ($regime)"
  echo -e "  Pattern: ${CYAN}$pattern${NC}"
  echo -e "  CLAUDE.md: $STATE_DIR/CLAUDE.md"
  echo -e "  Agents:    $STATE_DIR/agents.json"
  echo ""
  echo -e "Run ${BOLD}civagent run${NC} to start a CC session with this regime."
}

# ── run ──────────────────────────────────────────────────────────────────────

cmd_run() {
  [[ -f "$ACTIVE_FILE" ]] || die "No active regime. Run: civagent switch <regime>"
  local regime=$(cat "$ACTIVE_FILE")

  # v5 opt-in: isolated civ HOME + skill sedimentation
  if [[ "${1:-}" == "--v5" ]]; then
    shift
    echo -e "${CYAN}[civagent v5]${NC} Learning-loop mode for ${BOLD}$regime${NC}"
    exec node "$ENGINE_DIR/v5/run-v5.mjs" "$regime" "$@"
  fi

  local agents_json=$(cat "$STATE_DIR/agents.json")
  echo -e "${CYAN}[civagent]${NC} Launching CC with ${BOLD}$regime${NC} regime..."

  # Build claude command
  local cmd=(claude)

  # Add agents
  cmd+=(--agents "$agents_json")

  # Add system prompt from CLAUDE.md
  cmd+=(--system-prompt-file "$STATE_DIR/CLAUDE.md")

  # Parse mode override
  local mode=""
  local prompt_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode) mode="$2"; shift 2 ;;
      -p|--print) cmd+=("--print"); shift ;;
      *) prompt_args+=("$1"); shift ;;
    esac
  done

  # If mode specified, append mode instructions
  if [[ -n "$mode" && -f "$ENGINE_DIR/modes/$mode.md" ]]; then
    cmd+=(--append-system-prompt "$(cat "$ENGINE_DIR/modes/$mode.md")")
  fi

  # If prompt provided, run in print mode
  if [[ ${#prompt_args[@]} -gt 0 ]]; then
    cmd+=(-p "${prompt_args[*]}")
  fi

  exec "${cmd[@]}"
}

# ── agents ───────────────────────────────────────────────────────────────────

cmd_agents() {
  [[ -f "$ACTIVE_FILE" ]] || die "No active regime."
  local regime=$(cat "$ACTIVE_FILE")
  echo -e "${BOLD}CC Agents for $regime:${NC}\n"
  cat "$STATE_DIR/agents.json" | python3 -m json.tool 2>/dev/null || cat "$STATE_DIR/agents.json"
}

# ── modes ────────────────────────────────────────────────────────────────────

cmd_modes() {
  echo -e "${BOLD}CivAgent Orchestration Modes${NC}\n"
  echo -e "  ${CYAN}centralized${NC}      Qin/Yuan — Single coordinator, no review"
  echo -e "  ${CYAN}checks-balances${NC}  Tang/Venice — Draft→Review→Execute pipeline"
  echo -e "  ${CYAN}dual-track${NC}       Ming/Sparta — Two independent verification chains"
  echo -e "  ${CYAN}federation${NC}       Zhou/HRE — Autonomous domains, eventual sync"
  echo -e "  ${CYAN}democratic${NC}       Athens/Mongol — Parallel generation, majority vote"
  echo -e "  ${CYAN}theocratic${NC}       Shang/Egypt — Supreme agent, zero overhead"
  echo ""
  echo -e "Override with: ${BOLD}civagent run --mode <mode> \"prompt\"${NC}"
}

# ── setup ────────────────────────────────────────────────────────────────────

cmd_setup() {
  echo -e "${BOLD}CivAgent v4 Tool Check${NC}\n"

  # Claude Code
  if command -v claude &>/dev/null; then
    local cc_ver=$(command claude --version 2>/dev/null | head -1)
    echo -e "  ${GREEN}✓${NC} Claude Code    $cc_ver"
  else
    echo -e "  ${RED}✗${NC} Claude Code    not found"
  fi

  # Codex
  if command -v codex &>/dev/null; then
    local codex_ver=$(codex --version 2>/dev/null | head -1)
    echo -e "  ${GREEN}✓${NC} Codex CLI      $codex_ver"
  else
    echo -e "  ${RED}✗${NC} Codex CLI      not found"
  fi

  # opencode (skill audit / review fallback judge)
  if command -v opencode &>/dev/null; then
    echo -e "  ${GREEN}✓${NC} opencode       available"
  else
    echo -e "  ${YELLOW}○${NC} opencode       not found (optional judge fallback)"
  fi

  # CN models
  echo ""
  echo -e "  ${BOLD}CN Model Backends:${NC}"
  for cc in cc-doubao cc-qwen cc-kimi cc-glm cc-stepfun cc-minimax cc-mimo; do
    if command -v "$cc" &>/dev/null; then
      echo -e "    ${GREEN}✓${NC} $cc"
    else
      echo -e "    ${RED}✗${NC} $cc"
    fi
  done

  # Node.js
  echo ""
  if command -v node &>/dev/null; then
    echo -e "  ${GREEN}✓${NC} Node.js        $(node --version)"
  else
    echo -e "  ${RED}✗${NC} Node.js        not found (required for engine)"
  fi
}

# ── v5 inspection ────────────────────────────────────────────────────────────

cmd_replay() {
  local match_id="${1:-}"
  [[ -n "$match_id" ]] || die "Usage: civagent replay <matchId>"
  exec node "$ENGINE_DIR/v5/replay.mjs" "$match_id"
}

cmd_skills() {
  local regime="${1:-}"
  [[ -n "$regime" ]] || die "Usage: civagent skills <region/regime-id> [--stats]"
  validate_regime "$regime"
  local dir="$REGIMES_DIR/$regime/skills"

  if [[ "${2:-}" == "--stats" ]]; then
    CIVAGENT_ENGINE="$ENGINE_DIR" CIVAGENT_SKILLS_DIR="$dir" node --input-type=module -e '
const { analyzeSkillsDir } = await import(`${process.env.CIVAGENT_ENGINE}/v5/skill-quality.mjs`);
console.log(JSON.stringify(analyzeSkillsDir(process.env.CIVAGENT_SKILLS_DIR), null, 2));
'
    return
  fi
  if [[ ! -d "$dir" ]]; then
    echo "No learned skills yet for $regime."
    return
  fi
  echo -e "${BOLD}Learned skills — $regime${NC}"
  for f in "$dir"/*.md; do
    [[ -f "$f" ]] || continue
    echo -e "  ${GREEN}•${NC} $(basename "$f")"
    python3 -c "import re,sys;t=open(sys.argv[1]).read();m=re.search(r'description:\s*(.+)',t);print('    '+m.group(1)) if m else None" "$f" 2>/dev/null
  done
}

# List staged skills (supply-chain gate) across all regimes, or one regime.
cmd_skills_pending() {
  local regime="${1:-}"
  local found=0
  echo -e "${BOLD}Staged skills awaiting approval${NC}"
  for dir in "$REGIMES_DIR"/*/skills/staging "$REGIMES_DIR"/*/*/skills/staging; do
    [[ -d "$dir" ]] || continue
    local rid=$(basename "$(dirname "$(dirname "$dir")")")
    local region=$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")
    [[ -z "$regime" || "$region/$rid" == "$regime" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      found=$((found + 1))
      echo -e "  ${YELLOW}•${NC} $region/$rid  $(basename "$f")"
    done
  done
  [[ "$found" -gt 0 ]] || echo "  (none)"
}

# Promote one staged skill into the active skills dir.
cmd_skills_approve() {
  local regime="${1:-}"
  local file="${2:-}"
  [[ -n "$regime" && -n "$file" ]] || die "Usage: civagent skills approve <region/regime-id> <filename>"
  # Filename must be a bare basename — no path traversal out of staging.
  if [[ "$file" != "$(basename "$file")" || "$file" == .* ]]; then
    die "Invalid filename: $file"
  fi
  local staging="$REGIMES_DIR/$regime/skills/staging/$file"
  local dest_dir="$REGIMES_DIR/$regime/skills"
  [[ -f "$staging" ]] || die "Staged skill not found: $staging"
  mv "$staging" "$dest_dir/$file"
  echo -e "${GREEN}✓${NC} Approved: $regime/skills/$file"
}

cmd_match_log() {
  local dir="$STATE_DIR/matches"
  [[ -d "$dir" ]] || { echo "No matches yet."; return; }
  echo -e "${BOLD}Match history${NC}"
  ls -1t "$dir" 2>/dev/null | head -20 | while read m; do
    local meta="$dir/$m/meta.json"
    if [[ -f "$meta" ]]; then
      python3 -c "import json,sys;d=json.load(open(sys.argv[1]));print(f\"  {d.get('matchId','?')}  [{d.get('regime','?')} via {d.get('backend','?')}]  exit={d.get('exitCode','?')}\")" "$meta" 2>/dev/null || echo "  $m"
    else
      echo "  $m"
    fi
  done
}

cmd_tournament() {
  local civs=""
  local rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --civs) civs="$2"; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  if [[ -z "$civs" || ${#rest[@]} -eq 0 ]]; then
    die "Usage: civagent tournament --civs a/x,b/y,c/z \"task prompt\""
  fi
  exec node "$ENGINE_DIR/v5/tournament.mjs" --civs "$civs" "${rest[@]}"
}

# ── topology ────────────────────────────────────────────────────────────────

cmd_topology() {
  local sub="${1:-}"
  local regime="${2:-}"
  case "$sub" in
    validate|metrics)
      [[ -n "$regime" ]] || die "Usage: civagent topology $sub <region/regime-id>"
      local dir="$REGIMES_DIR/$regime"
      require_regime_metadata "$regime" "$dir"
      exec node "$ENGINE_DIR/topology/$sub.mjs" "$dir"
      ;;
    *)
      die "Usage: civagent topology <validate|metrics> <region/regime-id>"
      ;;
  esac
}

# Cross-tournament statistics: Bradley-Terry ranking + bootstrap CI (engine/v5/stats.mjs).
cmd_stats() {
  exec node "$ENGINE_DIR/v5/stats.mjs" "$@"
}

# Ablation variant generator (engine/ablate.mjs): A1 persona / A2 checks.
cmd_ablate() {
  exec node "$ENGINE_DIR/ablate.mjs" "$@"
}

# Baseline control variants (engine/baseline.mjs): solo / random-N / flat-N.
cmd_baseline() {
  exec node "$ENGINE_DIR/baseline.mjs" "$@"
}

# L4 hill-climbing loop (engine/v5/hillclimb.mjs): analyze → propose → validate → apply/rollback.
cmd_hillclimb() {
  exec node "$ENGINE_DIR/v5/hillclimb.mjs" "$@"
}

# Runtime graph reconstruction + declared-vs-runtime diff (R8-2).
cmd_runtime_graph() {
  local match_id="${1:-}"
  [[ -n "$match_id" ]] || die "Usage: civagent runtime-graph <matchId> [--diff] [--json]"
  shift
  exec node "$ENGINE_DIR/v5/runtime-graph.mjs" "$match_id" "$@"
}

# Verify the cn-cc-workflow launchers the cn:* backends depend on (engine/cn-cc.mjs).
cmd_doctor() {
  echo -e "${BOLD}CivAgent — cn-cc-workflow dependency check${NC}"
  CIVAGENT_ENGINE="$ENGINE_DIR" node --input-type=module -e '
const { checkCnCc } = await import(`${process.env.CIVAGENT_ENGINE}/cn-cc.mjs`);
const r = checkCnCc();
for (const b of r.present) console.log("  ✓ " + b.id + " → " + b.cmd);
for (const b of r.missing) console.log("  ✗ " + b.id + " → " + b.cmd + " (missing)");
if (!r.ok) { console.error("\nMissing cn-cc-workflow launchers. Install:\n  " + r.install + "\n  see " + r.repo); process.exit(1); }
console.log("\n✓ cn-cc execution engine ready (" + r.present.length + " backends)");
'

  # Validate topology.json for every regime that has one (others are skipped
  # silently — topology files are being rolled out incrementally).
  echo ""
  echo -e "${BOLD}Regime topology validation${NC}"
  local topo_fail=0
  local topo_count=0
  for dir in "$REGIMES_DIR"/*/*/; do
    [[ -f "$dir/topology.json" ]] || continue
    topo_count=$((topo_count + 1))
    if node "$ENGINE_DIR/topology/validate.mjs" "$dir" >/dev/null 2>&1; then
      echo -e "  ${GREEN}✓${NC} $(basename "$(dirname "$dir")")/$(basename "$dir")"
    else
      topo_fail=$((topo_fail + 1))
      echo -e "  ${RED}✗${NC} $(basename "$(dirname "$dir")")/$(basename "$dir")"
      node "$ENGINE_DIR/topology/validate.mjs" "$dir" 2>&1 | sed 's/^/      /'
    fi
  done
  echo -e "  ${CYAN}$topo_count${NC} regimes with topology.json, ${RED}$topo_fail${NC} invalid"
  [[ "$topo_fail" -eq 0 ]] || exit 1
}

# ── main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  list)      cmd_list ;;
  info)      cmd_info "${2:?Usage: civagent info <regime>}" ;;
  switch)    cmd_switch "${2:?Usage: civagent switch <regime>}" ;;
  run)       shift; cmd_run "$@" ;;
  agents)    cmd_agents ;;
  modes)     cmd_modes ;;
  setup)     cmd_setup ;;
  doctor)    cmd_doctor ;;
  topology)  cmd_topology "${2:-}" "${3:-}" ;;
  skills)
    case "${2:-}" in
      pending) cmd_skills_pending "${3:-}" ;;
      approve) cmd_skills_approve "${3:-}" "${4:-}" ;;
      *)       cmd_skills "${2:-}" "${3:-}" ;;
    esac ;;
  match-log) cmd_match_log ;;
  replay)    shift; cmd_replay "$@" ;;
  tournament) shift; cmd_tournament "$@" ;;
  stats)     shift; cmd_stats "$@" ;;
  ablate)    shift; cmd_ablate "$@" ;;
  baseline)  shift; cmd_baseline "$@" ;;
  hillclimb) shift; cmd_hillclimb "$@" ;;
  runtime-graph) shift; cmd_runtime_graph "$@" ;;
  help|--help|-h|"") usage ;;
  *)         echo "Unknown command: $1"; usage; exit 1 ;;
esac
